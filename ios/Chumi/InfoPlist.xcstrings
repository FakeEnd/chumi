{
  "sourceLanguage": "en",
  "strings": {
    "NSMicrophoneUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chumi uses the microphone to record meetings. Audio is saved on your iPhone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Chumi 需要麦克风来记录会议。录音保存在你的 iPhone 上。"
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chumi transcribes meetings using on-device speech recognition. Apple cloud recognition is not used."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Chumi 使用设备本地语音识别，将会议录音转换为文字。不会使用 Apple 云端识别。"
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect to your paired Mac to sync meeting transcripts and use its AI assistant."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接你配对的 Mac，同步会议文字并使用电脑上的 AI 助手。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
