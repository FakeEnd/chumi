    "Cannot reach your Mac. Run npm run start:mobile on the Mac, connect both devices to the same Wi-Fi, and allow Chumi in Settings → Privacy & Security → Local Network. Then try again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cannot reach your Mac. Run npm run start:mobile on the Mac, connect both devices to the same Wi-Fi, and allow Chumi in Settings → Privacy & Security → Local Network. Then try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法连接 Mac。请确认 Mac 已运行 npm run start:mobile、手机与 Mac 在同一 Wi-Fi，并在设置 → 隐私与安全性 → 本地网络中允许 Chumi，然后重试。"
          }
        }
