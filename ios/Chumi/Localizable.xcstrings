    "Audio could not be saved fast enough, so recording stopped safely. Check your storage and try again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio could not be saved fast enough, so recording stopped safely. Check your storage and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "音频写入未能跟上录音速度，已安全停止；请检查存储空间后重试。"
          }
        }
      }
    },
    "Audio only: allow speech recognition in Settings to enable transcription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio only: allow speech recognition in Settings to enable transcription"
