    "Allow Chumi to record in Settings → Privacy & Security → Microphone.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Chumi to record in Settings → Privacy & Security → Microphone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在系统设置 → 隐私与安全性 → 麦克风中允许 Chumi 录音。"
          }
        }
      }
    },
    "Allow Local Network access when connecting for the first time. Connect your iPhone and Mac to the same Wi-Fi.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Local Network access when connecting for the first time. Connect your iPhone and Mac to the same Wi-Fi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "首次连接时，请允许 iPhone 访问本地网络。手机与 Mac 先连接同一个 Wi-Fi。"
          }
        }
      }
    },
    "An iPhone requires HTTPS. Use the pairing code from your Mac. HTTP is only available for a simulator connecting to localhost.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An iPhone requires HTTPS. Use the pairing code from your Mac. HTTP is only available for a simulator connecting to localhost."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "真机连接需要 HTTPS。请使用 Mac 生成的配对码；HTTP 仅用于模拟器连接本机。"
          }
        }
      }
    },
    "Another recording is running or being saved. Try again shortly.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
