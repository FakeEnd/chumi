{
  "name": "chumi",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Personal AI listening companion for academic meetings and lectures (local transcription + subscription-based AI).",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "setup:speakers": "bash scripts/setup-speakers.sh",
    "setup": "bash scripts/setup.sh",
    "doctor": "node scripts/doctor.ts",
    "start": "node server/main.ts",
    "mobile:setup": "node scripts/mobile-setup.ts",
    "start:mobile": "CHUMI_MOBILE=1 node server/main.ts",
    "ios:doctor": "bash scripts/ios-doctor.sh",
    "ios:build": "bash scripts/ios-build.sh",
    "ios:format": "bash scripts/ios-format.sh",
    "dev:server": "CHUMI_DEV=1 node --watch server/main.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "build:native": "bash native/build.sh",
    "build:tools": "bash native/build.sh tools",
    "build:windows": "python scripts/build-windows.py",
    "app:windows": "electron native/windows/desktop",
    "package:windows": "python scripts/build-windows.py --installer",
    "build": "npm run build:web && npm run build:native",
    "app": "open build/Chumi.app",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test": "node --test tests/*.test.ts",
    "check": "npm run typecheck && npm test",
    "sample": "node scripts/make-sample.mjs",
    "acceptance": "node scripts/acceptance.ts"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "cross-spawn": "^7.0.6",
    "marked": "^18.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.6"
  }
}
