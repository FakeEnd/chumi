        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅录音：语音识别权限未开启，可在系统设置中允许"
          }
        }
      }
    },
    "Audio only: on-device recognition is unavailable for this language. Audio is still saved on your phone.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio only: on-device recognition is unavailable for this language. Audio is still saved on your phone."
