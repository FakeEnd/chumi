          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录音只保存在这台 iPhone 上。点击同步或使用 AI 时会发送文字；已同步过的会议会在录音结束后自动更新到 Mac。"
